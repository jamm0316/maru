{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(mdfind *)",
      "Bash(mdls *)",
      "Bash(pmset -g)",
      "Bash(pmset -g batt)",
      "Bash(pmset -g assertions)",
      "Bash(pmset -g therm)",
      "Bash(pmset -g ps)",
      "Bash(lsappinfo list)",
      "Bash(lsappinfo front)",
      "Bash(lsappinfo visibleProcessList)",
      "Bash(lsappinfo processList)",
      "Bash(sw_vers *)",
      "Bash(system_profiler *)",
      "Bash(defaults read *)",
      "Bash(defaults domains)",
      "Bash(networksetup -get*)",
      "Bash(networksetup -list*)",
      "Bash(scutil --get *)",
      "Bash(scutil --dns)",
      "Bash(scutil --nwi)",
      "Bash(brew list *)",
      "Bash(brew info *)",
      "Bash(brew --version)",
      "Bash(shortcuts list *)",
      "Bash(softwareupdate -l)",
      "Bash(softwareupdate --list)",
      "Bash(diskutil list *)",
      "Bash(diskutil info *)",
      "Bash(ioreg *)",
      "Bash(launchctl list *)",
      "Bash(launchctl print *)",
      "Bash(plutil -p *)",
      "Bash(uptime)",
      "Bash(vm_stat)",
      "Bash(top -l 1 *)",
      "Bash(df *)",
      "Bash(bin/maru status *)",
      "Bash(bin/maru doctor)",
      "Bash(bin/maru suggest)",
      "Bash(bin/maru log *)",
      "Bash(bin/maru hist *)",
      "Bash(bin/maru help)",
      "Bash(./bin/maru status *)",
      "Bash(./bin/maru doctor)",
      "Bash(./bin/maru suggest)",
      "Bash(./bin/maru log *)",
      "Bash(./bin/maru hist *)",
      "Bash(./bin/maru help)",
      "Bash(scripts/maru-status.sh *)",
      "Bash(./scripts/maru-status.sh *)",
      "Bash(scripts/hist *)",
      "Bash(./scripts/hist *)",
      "Bash(bin/maru project list)",
      "Bash(./bin/maru project list)",
      "Bash(bin/maru project add *)",
      "Bash(./bin/maru project add *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-state.sh busy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-state.sh busy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-state.sh idle"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-state.sh idle"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-state.sh waiting"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-state.sh sub-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-state.sh sub-stop"
          }
        ]
      }
    ]
  }
}
