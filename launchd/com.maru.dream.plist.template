<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install.sh 가 {{...}} 자리표시자를 실제 경로로 바꿔 ~/Library/LaunchAgents/ 에 만든다 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.maru.dream</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{MARU_HOME}}/scripts/dream.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>{{HOME}}</string>
    <key>PATH</key><string>{{HOME}}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>{{MARU_DATA}}/logs/dream.launchd.log</string>
  <key>StandardErrorPath</key><string>{{MARU_DATA}}/logs/dream.launchd.log</string>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
