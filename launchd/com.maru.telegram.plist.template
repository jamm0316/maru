<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install.sh --with-telegram 이 {{...}} 자리표시자를 실제 경로로 바꿔 ~/Library/LaunchAgents/ 에 만든다. 로그인 후에만 시작된다. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.maru.telegram</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{MARU_HOME}}/scripts/telegram.sh</string>
    <string>start</string>
    <string>--unattended</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>{{HOME}}</string>
    <key>TERM</key><string>xterm-256color</string>
{{CLAUDE_CONFIG_ENV}}    <key>PATH</key><string>{{HOME}}/.local/bin:{{HOME}}/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>{{MARU_DATA}}/logs/telegram.launchd.log</string>
  <key>StandardErrorPath</key><string>{{MARU_DATA}}/logs/telegram.launchd.log</string>
  <key>RunAtLoad</key><true/>
  <!-- start 는 tmux 세션을 띄우고 바로 끝난다. 세션(tmux 서버)이 같이 죽지 않게 한다 -->
  <key>AbandonProcessGroup</key><true/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
