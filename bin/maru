#!/bin/bash
# maru 런처. 아무것도 설치·수정하지 않는다(PATH 등록 없음). bash 3.2 호환.
# 사용: maru [ui|app|suggest [번호]|todo [번호]|squad ...|status|log [reflect|dream]|hist ...|doctor|help]
set -u

# 자기 자신의 실제 경로(심볼릭 링크 해석)로 저장소 위치를 계산한다.
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  d=$(cd "$(dirname "$src")" && pwd -P)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src=$d/$src ;; esac
done
MARU_HOME=$(cd "$(dirname "$src")/.." && pwd -P)
export MARU_HOME
LOGDIR=${MARU_LOGS:-${MARU_DATA:-$MARU_HOME/data}/logs}

# 도구(python3/git) 실행 가능 여부와 기억 폴더 경로는 scripts/lib.sh 가 판정한다(폴백 경로 포함, 실패하면 exit 69).
# ui/suggest 는 그 검증을 거친 뒤에만 python3 를 실행한다.
need_env() {
  # shellcheck disable=SC1091
  . "$MARU_HOME/scripts/lib.sh" || exit 1
  export MEM
}

usage() {
  cat <<'USAGE'
maru — 개인 에이전트 마루 런처
  maru                 저장소에서 claude 실행(스쿼드가 있으면 --agents 로 함께)
  maru ui              상황판(TUI): 1상태 2기억 3로그 4제안 5추천
  maru app             데스크톱 앱 실행(/Applications/Maru.app 이 있으면 그것, 없으면 app 폴더에서 npm start)
  maru suggest [번호]  추천 요청 목록 보기 / 그 번호의 줄을 클립보드에 복사(전송 안 함)
  maru todo [번호]     오늘 할 일 목록(태그별) 보기 / 그 번호의 프롬프트를 클립보드에 복사(없으면 직접 할 일)
  maru squad [list]    스쿼드 목록(내장+개인, 제외된 것과 이유)
  maru squad check <폴더>                         제안 폴더 검토(통과/거부 사유, 위험 신호)
  maru squad install <폴더> [--replace] [--ack-warnings]   검증 통과 시 data/squads/ 로 설치(위험 신호가 있으면 --ack-warnings 필요)
  maru squad remove <slug>                        개인 스쿼드를 data/squads-trash/ 로 옮김(영구 삭제 아님)
  maru squad remove --proposal <slug>             제안함(data/squad-proposals/)의 제안을 data/squads-trash/ 로 옮김(영구 삭제 아님)
  maru status          maru-status.sh 출력 (--json 등 옵션 전달)
  maru log [reflect|dream]   로그 마지막 줄 보기(기본 reflect)
  maru project list    열린 프로젝트 목록 / maru project add <태그> <슬러그> <제목>: 프로젝트 등록(인자 정확히 3개)
  maru hist ...        기억 변경 이력(읽기 전용: log show diff status ls-files)
  maru doctor          읽기 전용 점검
  maru help            이 도움말
USAGE
}

doctor() {
  local bad=0 lib_rc out
  ok()   { printf 'OK    %s\n' "$*"; }
  warn() { printf '주의  %s\n' "$*"; bad=$((bad+1)); }
  xcode_hint() { printf '      -> Xcode 라이선스 미동의로 보임: 터미널에서 sudo xcodebuild -license\n'; }

  if command -v claude >/dev/null 2>&1; then ok "claude 명령: $(command -v claude)"; else warn "claude 명령을 찾을 수 없음(PATH 확인)"; fi

  # lib.sh 를 soft 모드로 불러 도구 판정·기억 폴더 계산 결과를 읽는다(실패해도 doctor 는 계속한다)
  # shellcheck disable=SC1091
  MARU_LIB_SOFT=1 . "$MARU_HOME/scripts/lib.sh" 2>/dev/null; lib_rc=$?
  unset MARU_LIB_SOFT
  if [ -n "$MARU_PY_FALLBACK" ]; then
    warn "python3 폴백 사용 중(원인: $MARU_PY_WHY) -> $MARU_PY_FALLBACK"
    case "$MARU_PY_WHY" in *license*|*xcodebuild*) xcode_hint ;; esac
  fi
  if [ -n "$MARU_GIT_FALLBACK" ]; then
    warn "git 폴백 사용 중(원인: $MARU_GIT_WHY) -> $MARU_GIT_FALLBACK"
    case "$MARU_GIT_WHY" in *license*|*xcodebuild*) xcode_hint ;; esac
  fi
  if [ "$lib_rc" -ne 0 ]; then
    warn "도구/기억 폴더 확인 실패: $MARU_ENV_ERR"
  else
    [ -n "$MARU_PY_FALLBACK" ] || ok "python3 동작"
    [ -n "$MARU_GIT_FALLBACK" ] || ok "git 동작"
    if [ -d "$MEM" ]; then ok "기억 폴더 경로 유효: $MEM"; else warn "기억 폴더 경로는 올바르나 폴더가 없음: $MEM"; fi
  fi

  local sj=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json
  if [ -f "$sj" ]; then
    if grep -q 'reflect\.sh' "$sj" 2>/dev/null && grep -q '"SessionEnd"' "$sj" 2>/dev/null; then
      ok "SessionEnd 훅에 reflect.sh 등록됨(문자열 검사, 구조까지는 미검증)"
    else
      warn "settings.json 에서 SessionEnd + reflect.sh 를 찾지 못함(install.sh 참고)"
    fi
  else
    warn "settings.json 없음: $sj"
  fi

  if launchctl list com.maru.dream >/dev/null 2>&1; then ok "launchd com.maru.dream 로드됨"
  else warn "launchd com.maru.dream 로드 안 됨(install.sh 참고)"; fi

  local pl=$HOME/Library/LaunchAgents/com.maru.dream.plist sz
  if [ -f "$pl" ]; then
    sz=$(stat -f %z "$pl" 2>/dev/null || echo 0)
    if [ "$sz" -lt 100 ]; then warn "plist 가 비정상적으로 작음(${sz}바이트): $pl -> ./install.sh 로 다시 설치"
    elif plutil -lint "$pl" >/dev/null 2>&1; then ok "plist ${sz}바이트, plutil -lint 통과"
    else warn "plist plutil -lint 실패: $pl"; fi
  else
    warn "plist 없음: $pl(install.sh 참고)"
  fi

  local f hit any=0 streak
  for f in reflect dream; do
    if [ -f "$LOGDIR/$f.log" ]; then
      any=1
      hit=$(tail -n 200 "$LOGDIR/$f.log" | grep -E 'rc=[1-9][0-9]*|되돌림|연속 실패|거부|환경 오류' | tail -n 1)
      if [ -n "$hit" ]; then warn "$f.log 최근 200줄에 실패 흔적: $hit"; else ok "$f.log 최근 200줄에 실패 흔적 없음"; fi
    fi
  done
  [ "$any" = 1 ] || warn "로그 없음: $LOGDIR"
  if [ -f "$LOGDIR/dream.log" ]; then
    # 실행("시작" 줄) 단위로 묶어, 가장 최근 실행부터 연속으로 스냅샷 실패/환경 오류였던 횟수를 센다
    streak=$(tail -n 400 "$LOGDIR/dream.log" | awk '
      /\[dream\] 시작/ { n++; bad[n]=0; next }
      /스냅샷 실패|환경 오류/ { if (n) bad[n]=1 }
      END { c=0; for (i=n; i>=1; i--) { if (bad[i]) c++; else break } print c+0 }')
    if [ "${streak:-0}" -ge 1 ]; then warn "dream.log: 최근 새벽 정리 ${streak}회 연속 스냅샷 실패/환경 오류 -> maru doctor 위 항목과 dream.log 확인"
    else ok "dream.log: 최근 새벽 정리에 스냅샷 실패/환경 오류 연속 없음"; fi
  fi

  [ "$bad" = 0 ] && echo "모두 정상" || echo "주의 ${bad}건"
  return 0
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  "") cd "$MARU_HOME" && exec "$MARU_HOME/scripts/maru-claude.sh" ;;
  squad)
    need_env
    export MARU_DATA
    sub=${1:-list}; [ $# -gt 0 ] && shift
    case "$sub" in list|check|install|remove) ;; *) echo "squad: list | check <폴더> | install <폴더> [--replace] [--ack-warnings] | remove [--proposal] <slug>" >&2; exit 2 ;; esac
    exec python3 -I "$MARU_HOME/scripts/squads.py" "$sub" "$@" ;;
  project)
    need_env
    export MARU_DATA
    sub=${1:-}; [ $# -gt 0 ] && shift
    case "$sub" in
      list) [ $# -eq 0 ] || { echo "project list" >&2; exit 2; }; project_list; exit $? ;;
      add) project_add "$@"; exit $? ;;
      *) echo "project: list | add <태그> <슬러그> <제목>" >&2; exit 2 ;;
    esac ;;
  ui)
    need_env
    exec python3 "$MARU_HOME/scripts/maru_ui.py" "$@" ;;
  app)
    if [ -d /Applications/Maru.app ]; then exec open -a /Applications/Maru.app --env "MARU_HOME=$MARU_HOME"; fi
    if [ ! -d "$MARU_HOME/app/node_modules" ]; then
      echo "앱 의존성이 없습니다. 먼저 설치하세요: cd \"$MARU_HOME/app\" && DEVELOPER_DIR=/Library/Developer/CommandLineTools npm install" >&2
      exit 1
    fi
    cd "$MARU_HOME/app" && exec npm start ;;
  suggest)
    need_env
    exec python3 "$MARU_HOME/scripts/maru_ui.py" --suggest "$@" ;;
  todo)
    need_env
    exec python3 "$MARU_HOME/scripts/todo_cli.py" "$@" ;;
  status) exec "$MARU_HOME/scripts/maru-status.sh" "$@" ;;
  log)
    kind=${1:-reflect}
    case "$kind" in reflect|dream) ;; *) echo "log: reflect 또는 dream" >&2; exit 2 ;; esac
    [ -f "$LOGDIR/$kind.log" ] || { echo "로그 없음: $LOGDIR/$kind.log" >&2; exit 1; }
    exec tail -n 50 "$LOGDIR/$kind.log" ;;
  hist) exec "$MARU_HOME/scripts/hist" "$@" ;;
  doctor) doctor ;;
  help|-h|--help) usage ;;
  *) echo "알 수 없는 명령: $cmd" >&2; usage >&2; exit 2 ;;
esac
