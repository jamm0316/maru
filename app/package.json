{
  "name": "maru-app",
  "version": "0.1.0",
  "private": true,
  "description": "마루 데스크톱 앱 (터미널 + 주변 패널)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test.js",
    "rebuild": "DEVELOPER_DIR=/Library/Developer/CommandLineTools electron-rebuild -f -w node-pty",
    "postinstall": "DEVELOPER_DIR=/Library/Developer/CommandLineTools electron-rebuild -f -w node-pty",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false DEVELOPER_DIR=/Library/Developer/CommandLineTools electron-builder --mac dmg --arm64 && node tools/verify-bundle.js"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "author": "maru",
  "build": {
    "appId": "com.maru.app",
    "productName": "Maru",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib.js",
      "i18n.js",
      "updater.js",
      "renderer/**",
      "package.json",
      "!**/node_modules/node-pty/{src,deps,third_party,scripts,typings,binding.gyp,README.md}/**",
      "!**/node_modules/node-pty/{binding.gyp,README.md}",
      "!**/node_modules/node-pty/prebuilds/{win32-*,darwin-x64}/**",
      "!**/node_modules/node-pty/build/{obj.target,node-addon-api}/**",
      "!**/node_modules/node-pty/lib/**/*.test.js*",
      "!**/node_modules/node-pty/lib/**/*.map",
      "!**/node_modules/node-addon-api/**",
      "!**/*.pdb"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "dmg": {
      "sign": false
    },
    "afterPack": "tools/after-pack.js",
    "extraResources": [
      {
        "from": "build/trayTemplate.png",
        "to": "tray/trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "tray/trayTemplate@2x.png"
      },
      {
        "from": "../scripts",
        "to": "payload/scripts",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store",
          "!test-*.sh"
        ]
      },
      {
        "from": "../prompts",
        "to": "payload/prompts",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "../squads",
        "to": "payload/squads",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "../squads-en",
        "to": "payload/squads-en",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "../launchd",
        "to": "payload/launchd",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "../bin",
        "to": "payload/bin",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "../install.sh",
        "to": "payload/install.sh"
      },
      {
        "from": "../uninstall.sh",
        "to": "payload/uninstall.sh"
      },
      {
        "from": "../CLAUDE.md",
        "to": "payload/CLAUDE.md"
      },
      {
        "from": "../CLAUDE.en.md",
        "to": "payload/CLAUDE.en.md"
      },
      {
        "from": "../README.md",
        "to": "payload/README.md"
      },
      {
        "from": "../docs/manual.ko.md",
        "to": "payload/docs/manual.ko.md"
      },
      {
        "from": "../.claude/agents",
        "to": "payload/.claude/agents",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "../.claude/skills",
        "to": "payload/.claude/skills",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "../.claude/settings.json",
        "to": "payload/.claude/settings.json"
      }
    ]
  }
}
