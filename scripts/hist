#!/bin/bash
# 개인 변경 이력(기억 폴더만 추적) 조회 도구. 읽기 전용 명령만 허용한다: log show diff status ls-files
# (쓰기·되돌리기는 scripts 내부에서만 한다. 사람·에이전트가 checkout/reset/clean 등을 실수로 쓰지 못하게 막는다.)
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib.sh"
case "${1:-}" in
  log|show|diff|status|ls-files) hist_git "$@" ;;
  *) echo "hist: '${1:-}' 는 허용되지 않습니다. 허용: log show diff status ls-files" >&2; exit 2 ;;
esac
